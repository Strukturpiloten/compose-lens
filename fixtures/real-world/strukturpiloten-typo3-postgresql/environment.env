# Deterministic interpolation values for tests. These are not deployment credentials.
PODMAN_NAMESPACE=strukturpiloten
PODMAN_SERVICE=typo3
PODMAN_STAGE=test
PODMAN_USER_UID=1000
PODMAN_GROUP_GID=1000

DATABASE_SQL_SERVICE=postgresql
DATABASE_SQL_HOST=postgresql
DATABASE_SQL_PORT=5432
DATABASE_SQL_NAME=typo3
DATABASE_SQL_USER=typo3
DATABASE_SQL_PASSWORD=fixture-database-password

PODMAN_TYPO3INSTALLER_ENTRYPOINT_SCRIPT_FILE_HOST=./runtime/configs/typo3-installer/entrypoint_default.sh
PODMAN_TYPO3INSTALLER_ENTRYPOINT_SCRIPT_FILE_CONTAINER=/etc/entrypoint.sh
PODMAN_TYPO3MANAGER_CRON_ROOT_FILE_HOST=./runtime/configs/typo3-manager/cron/cron
PODMAN_TYPO3MANAGER_CRON_ROOT_FILE_CONTAINER=/etc/crontabs/cron
PODMAN_TYPO3MANAGER_ENTRYPOINT_SCRIPT_FILE_HOST=./runtime/configs/typo3-manager/entrypoint_default.sh
PODMAN_TYPO3MANAGER_ENTRYPOINT_SCRIPT_FILE_CONTAINER=/etc/entrypoint.sh

PODMAN_POSTGRES_IMAGE=docker.io/postgres:18.4-alpine3.22@sha256:774521500f4c22761b25a6bdb772a0a3c2e8dd32468210bdad9231c5752ea398
PODMAN_POSTGRES_DATA_DIR_HOST=./runtime/postgres
PODMAN_POSTGRES_DATA_DIR_CONTAINER=/var/lib/postgresql/data

PODMAN_NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.29.3-alpine3.22@sha256:5aea7cc516b419e3526f47dd1531be31a56a046cfe44754d94f9383e13e2ee99
PODMAN_NGINX_CONF_DIR_HOST=./runtime/configs/nginx/conf
PODMAN_NGINX_CONF_DIR_CONTAINER=/etc/nginx/conf.d

PODMAN_TYPO3PHPFPM_IMAGE=ghcr.io/strukturpiloten/typo3-phpfpm:latest
PODMAN_TYPO3PHPFPM_PULL_POLICY=missing
PODMAN_TYPO3PHPFPM_CONF_FILE_HOST=./runtime/configs/typo3-phpfpm/conf/zzz-www_default.conf
PODMAN_TYPO3PHPFPM_CONF_FILE_CONTAINER=/usr/local/etc/php-fpm.d/zzz-www.conf
PODMAN_TYPO3PHPFPM_INI_FILE_HOST=./runtime/configs/typo3-phpfpm/ini/typo3_default.ini
PODMAN_TYPO3PHPFPM_INI_FILE_CONTAINER=/usr/local/etc/php/conf.d/typo3.ini

PODMAN_TYPO3_DATA_DIR_HOST=./runtime/typo3
PODMAN_TYPO3_DATA_DIR_CONTAINER=/var/www/typo3
PODMAN_TYPO3_USER_DATA_DIR_CONTAINER=/var/www/typo3/public/fileadmin

TYPO3_VERSION=14.3.1
TYPO3_COMPOSER_PACKAGE=typo3/cms-base-distribution
TYPO3_BIN_RELATIVE_PATH=vendor/bin/typo3
TYPO3_DB_DRIVER=postgres
TYPO3_DISTRIBUTION=none
TYPO3_PROJECT_NAME=typo3
TYPO3_SERVER_TYPE=other
TYPO3_SETUP_ADMIN_USERNAME=admin
TYPO3_SETUP_ADMIN_PASSWORD=fixture-admin-password
TYPO3_SETUP_ADMIN_EMAIL=typo3@example.invalid
TYPO3_SETUP_CREATE_SITE=https://typo3.example.invalid/
TYPO3_OPTIONAL_INSTALL_COMMANDS=
