{
  "name": "ComposeLens",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/compose-lens,type=bind",
  "workspaceFolder": "/workspaces/compose-lens",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "version": "2.97.0"
    }
  },
  "containerEnv": {
    "CARGO_HOME": "/workspaces/.compose-lens-cargo",
    "CARGO_TARGET_DIR": "/workspaces/.compose-lens-target",
    "PATH": "/home/vscode/.local/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  },
  "mounts": [
    "source=compose-lens-cargo-${devcontainerId},target=/workspaces/.compose-lens-cargo,type=volume",
    "source=compose-lens-target-${devcontainerId},target=/workspaces/.compose-lens-target,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/verify-tools.sh && cargo fetch --locked",
  "waitFor": "postCreateCommand",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "DavidAnson.vscode-markdownlint",
        "redhat.vscode-yaml",
        "rust-lang.rust-analyzer",
        "streetsidesoftware.code-spell-checker",
        "tombi-toml.tombi",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
